# Copy this file to .env and fill in your key.
# All examples use OpenAI by default because it's the most common starting
# point, but LangChain has near-identical wrappers for Anthropic, Google,
# Ollama (local models), etc. Swap the import + model name if you'd rather
# use one of those.
OPENAI_API_KEY=sk-...

# Optional: only needed for the LangSmith tracing note in the README.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=langgraph-learning
